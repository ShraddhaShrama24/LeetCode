class Solution {
public:
    int minSubArrayLen(int target, vector<int>& nums) {
        int n = nums.size();
        int min_l = 0;
        for (int i = 0; i < n; i++) {
            if (nums[i] >= target) return 1;
            int current_sum = 0;
            for (int j = i; j < n; j++) {
                current_sum += nums[j];
                if (current_sum >= target) {
                    int current_len = j - i + 1;
                    if (min_l == 0 || current_len < min_l) {
                        min_l = current_len;
                    }
                    break; 
                }
            }
        }
        return min_l;
    }
};   
